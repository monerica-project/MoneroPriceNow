@page "/millionaire"
@model CryptoPriceNow.Pages.MillionaireModel
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    string Xmr(decimal? v) => v is decimal d ? d.ToString("N2", inv) : "--";
    string Usd(decimal? v) => v is decimal d ? "$" + d.ToString("N2", inv) : "--";
    var now = Model.Data.Xmr;
    ViewData["Title"] = now is decimal n
        ? $"Monero Millionaire: {Xmr(n)} XMR = 1,000,000 USDT — MoneroPriceNow"
        : "Monero Millionaire — MoneroPriceNow";
    ViewData["Description"] = "How much Monero (XMR) you need to be a USDT millionaire, live, and how that changed over the last day, week, month and 90 days.";
}

<style>
    .mm-page { max-width: 820px; margin: 2.5rem auto 4rem; padding: 0 1.25rem; font-family: var(--sans); color: var(--text); text-align: center; }
    .mm-page h1 { font-family: var(--mono); font-size: 1.5rem; margin-bottom: .4rem; }
    .mm-lead { color: var(--text-muted); margin-bottom: 1.6rem; }
    .mm-amount { font-family: var(--mono); font-size: clamp(2.6rem, 9vw, 4.6rem); font-weight: 700; color: var(--xmr-orange2); line-height: 1.1; word-break: break-word; }
    .mm-unit { font-size: .45em; color: var(--text); margin-left: .25em; }
    .mm-sub { font-family: var(--mono); color: var(--text-muted); margin: .6rem 0 2rem; font-size: .92rem; }
    .mm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .8rem; margin: 0 0 2rem; }
    .mm-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: .9rem 1rem; text-align: left; }
    .mm-card .lbl { color: var(--text-muted); font-size: .85rem; }
    .mm-card .val { font-family: var(--mono); font-size: 1.2rem; margin: .2rem 0; }
    .mm-card .chg { font-family: var(--mono); font-size: .85rem; }
    .mm-up { color: #ff6b6b; }   /* more XMR needed = XMR got cheaper */
    .mm-down { color: #3ddc84; } /* less XMR needed = XMR got pricier */
    .mm-chart { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; height: 320px; }
    .mm-note { color: var(--text-muted); font-size: .85rem; margin-top: 1rem; line-height: 1.7; }
    .mm-page a { color: var(--xmr-orange2); text-decoration: none; border-bottom: 1px solid rgba(242,104,34,.35); }
    .mm-page a:hover { border-bottom-color: var(--xmr-orange2); }
</style>

<div class="mm-page">
    <h1>Monero Millionaire</h1>
    <p class="mm-lead">XMR needed to be a USDT millionaire right now</p>

    <div class="mm-amount"><span id="mmXmr">@Xmr(now)</span><span class="mm-unit">XMR</span></div>
    <div class="mm-sub">= 1,000,000 USDT at <span id="mmPrice">@Usd(Model.Data.Price)</span> per XMR &middot; updates every 15 seconds</div>

    <div class="mm-grid">
        @foreach (var c in Model.Data.Comparisons)
        {
            var diff = c.Xmr is decimal then && now is decimal cur ? cur - then : (decimal?)null;
            <div class="mm-card" data-days="@c.Days">
                <div class="lbl">@c.Label</div>
                <div class="val"><span class="mm-then">@Xmr(c.Xmr)</span> XMR</div>
                <div class="chg mm-chg @(diff > 0 ? "mm-up" : diff < 0 ? "mm-down" : "")">
                    @if (diff is decimal d)
                    {
                        @(d > 0 ? Math.Abs(d).ToString("N2", inv) + " more XMR needed now" : d < 0 ? Math.Abs(d).ToString("N2", inv) + " fewer XMR needed now" : "same as now")
                    }
                </div>
                <div class="lbl">at <span class="mm-thenprice">@Usd(c.Price)</span></div>
            </div>
        }
    </div>

    <div class="mm-chart"><canvas id="mmChart" aria-label="XMR needed for 1,000,000 USDT over the last 90 days"></canvas></div>
    <p class="mm-note">
        XMR needed for 1,000,000 USDT, last 90 days<br />
        Price: average of live buy and sell quotes across exchanges, as on the <a href="~/">home page</a>
    </p>
</div>

<script id="mmData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true" defer></script>
    <script src="~/js/millionaire.js" asp-append-version="true" defer></script>
}
