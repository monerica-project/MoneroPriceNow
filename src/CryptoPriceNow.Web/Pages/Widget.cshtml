@page "/widget"
@{
    ViewData["Title"] = "Monero Price Widget and Badge for Your Website — MoneroPriceNow";
    ViewData["Description"] = "Free Monero price widget and badge. Copy one line of HTML to show the live XMR price on your own site. No JavaScript, no tracking, no account.";
    const string frame = "<iframe src=\"https://moneropricenow.com/embed/price\" width=\"260\" height=\"112\" style=\"border:0\" loading=\"lazy\" title=\"Monero price\"></iframe>";
    const string badge = "<a href=\"https://moneropricenow.com/\"><img src=\"https://moneropricenow.com/badge/xmr-usd.svg\" alt=\"Monero price\" height=\"28\"></a>";
}

<style>
    .wd-page { max-width: 820px; margin: 2.5rem auto 4rem; padding: 0 1.25rem; font-family: var(--sans); color: var(--text); }
    .wd-page h1 { font-family: var(--mono); font-size: 1.5rem; margin-bottom: .4rem; }
    .wd-page h2 { font-family: var(--mono); font-size: 1.1rem; margin: 2rem 0 .7rem; }
    .wd-lead { color: var(--text-muted); margin-bottom: 1.4rem; line-height: 1.7; }
    .wd-code { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: .8rem; font-family: var(--mono); font-size: .82rem; white-space: pre-wrap; word-break: break-all; margin: .8rem 0 1rem; }
    .wd-page a { color: var(--xmr-orange2); text-decoration: none; }
</style>

<div class="wd-page">
    <h1>Monero Price Widget</h1>
    <p class="wd-lead">
        Show the live Monero price on your own website. Copy one line of HTML. There is no JavaScript, no tracking, no cookie and no account.
        The price is the same mid-market XMR/USD figure shown on our <a href="/">price board</a>.
    </p>

    <h2>Price card</h2>
    <iframe src="/embed/price" width="260" height="112" style="border:0" loading="lazy" title="Monero price"></iframe>
    <code class="wd-code">@frame</code>

    <h2>Badge</h2>
    <p><a href="/"><img src="/badge/xmr-usd.svg" alt="Monero price" height="28" /></a></p>
    <code class="wd-code">@badge</code>

    <h2>Need the raw numbers?</h2>
    <p class="wd-lead">Developers can use the free public <a href="https://api.moneropricenow.com/" rel="noopener">price API</a>, which needs no key.</p>
</div>
