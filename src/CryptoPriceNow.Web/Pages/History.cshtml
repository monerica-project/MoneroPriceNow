@page "/history"
@model CryptoPriceNow.Pages.HistoryModel
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    string Usd(decimal? v) => v is decimal d ? "$" + d.ToString("N2", inv) : "--";
    string Change(decimal? then, decimal? now) => then is decimal t && now is decimal n && t > 0m
        ? ((n - t) / t * 100m).ToString("+0.00;-0.00", inv) + "%" : "--";
    ViewData["Title"] = "Monero Price History: XMR to USD by Day — MoneroPriceNow";
    ViewData["Description"] = "Monero (XMR) price history in US dollars: today's price against 1, 7, 30 and 90 days ago, and the closing price for each of the last 90 days.";
    var days = Model.Days;
}

<style>
    .ph-page { max-width: 820px; margin: 2.5rem auto 4rem; padding: 0 1.25rem; font-family: var(--sans); color: var(--text); }
    .ph-page h1 { font-family: var(--mono); font-size: 1.5rem; margin-bottom: .4rem; }
    .ph-page h2 { font-family: var(--mono); font-size: 1.1rem; margin: 2rem 0 .7rem; }
    .ph-lead { color: var(--text-muted); margin-bottom: 1.4rem; }
    .ph-big { font-family: var(--mono); font-size: clamp(2rem, 7vw, 3.4rem); font-weight: 700; color: var(--xmr-orange2); }
    .ph-table { width: 100%; border-collapse: collapse; font-family: var(--mono); }
    .ph-table th, .ph-table td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--border); }
    .ph-table th { color: var(--text-muted); font-weight: 600; font-size: .85rem; }
    .ph-up { color: #3ddc84; } .ph-down { color: #ff6b6b; }
    .ph-note { color: var(--text-muted); font-size: .88rem; line-height: 1.7; margin-top: 1rem; }
    .ph-page a { color: var(--xmr-orange2); text-decoration: none; }
</style>

<div class="ph-page">
    <h1>Monero Price History</h1>
    <p class="ph-lead">XMR price in US dollars, now and over the last 90 days</p>
    <div class="ph-big">@Usd(Model.Now)</div>

    <h2>Now compared with earlier</h2>
    <table class="ph-table">
        <thead><tr><th>When</th><th>Price</th><th>Change to today</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Comparisons)
            {
                var up = c.Price is decimal cp && Model.Now is decimal n && n >= cp;
                <tr><td>@c.Label</td><td>@Usd(c.Price)</td><td class="@(up ? "ph-up" : "ph-down")">@Change(c.Price, Model.Now)</td></tr>
            }
        </tbody>
    </table>

    @if (days.Count > 1)
    {
        <h2>Price by day</h2>
        <table class="ph-table">
            <thead><tr><th>Date (UTC)</th><th>Closing price</th><th>Change from the day before</th></tr></thead>
            <tbody>
                @for (var i = 0; i < days.Count; i++)
                {
                    decimal? prev = i + 1 < days.Count ? days[i + 1].Price : null;
                    var up = prev is decimal pv && days[i].Price >= pv;
                    <tr>
                        <td>@days[i].Date.ToString("yyyy-MM-dd", inv)</td>
                        <td>@Usd(days[i].Price)</td>
                        <td class="@(prev is null ? "" : up ? "ph-up" : "ph-down")">@Change(prev, days[i].Price)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <p class="ph-note">
        Prices are the mid-market XMR/USDT price across the exchanges on our <a href="/">live price board</a>, recorded by this site.
        The closing price is the last price recorded each day in UTC. See also the
        <a href="/convert/xmr-to-usd">XMR to USD converter</a> and the <a href="/millionaire">Monero Millionaire</a> page.
    </p>
</div>
