@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var torUrl = Config["TorUrl"];
    var hasTor = !string.IsNullOrEmpty(torUrl);
    var isOnTor = Context.Request.Host.Host.EndsWith(".onion", StringComparison.OrdinalIgnoreCase);
    var donationAddress = Config["DonationAddress"]?.Trim();
    var hasDonation = !string.IsNullOrEmpty(donationAddress);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @if (ViewData["Description"] is string desc && !string.IsNullOrEmpty(desc))
    {
        <meta name="description" content="@desc" />
    }
    @{
        // Canonical URL: always the clearnet apex host with a lowercase, query-less path, so
        // mixed-case links, the .onion host, and any tracking params all consolidate onto one
        // indexable URL. A page may override via ViewData["Canonical"].
        var canonicalUrl = ViewData["Canonical"] as string;
        if (string.IsNullOrEmpty(canonicalUrl))
        {
            var canonicalPath = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
            canonicalUrl = "https://moneropricenow.com" + canonicalPath;
        }
    }
    <link rel="canonical" href="@canonicalUrl" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/moneropricenow-2026-05-30.css" asp-append-version="true" />
</head>
<body>
    <noscript>
        <div style="background:#ff7a1a;color:#111;text-align:center;padding:8px 12px;font-size:.9rem;font-weight:600;">
            JavaScript is off, so live prices and charts won't load here. &rarr;
            <a href="/nojs" style="color:#111;text-decoration:underline;">Open the no-JavaScript version</a>
        </div>
    </noscript>
<!-- ── Sponsor bar ── -->
    <div class="sponsor-bar">
        <span class="sb-label">Sponsors</span>
        <div class="sponsor-bar-track" id="sponsorBarTrack" aria-label="Sponsors"></div>
    </div>

    <!-- ── Page content ── -->
    <div class="page-body">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ── Footer ── -->
    <footer class="site-footer">
        <span>
            © @System.DateTime.UtcNow.Year MoneroPriceNow.com |
            <a href="~/">Home</a> |
            <a href="~/exchanges">Exchanges</a> |
            <a href="~/about">About</a> |
            <a href="~/network">Network</a> |
            <a href="~/sponsors">Sponsors</a> |
            <a href="~/nojs">No-JS version</a> |
            <a href="https://github.com/monerica-project/MoneroPriceNow" target="_blank">Code</a> |
            <a href="~/contact">Contact</a>
            @if (hasDonation)
            {
                <text> | <a href="monero:@donationAddress" title="@donationAddress">Donate</a></text>
            }
            @if (hasTor && !isOnTor)
            {
                <text> | <a href="@torUrl" rel="noopener noreferrer">Tor</a></text>
            }
        </span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <!-- Sponsor bar on every page (the homepage script no longer renders it). -->
    <script src="~/js/sponsorbar.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>